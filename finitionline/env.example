# FinitiOnline - משתני סביבה. להעתיק לקובץ בשם .env באותה תיקייה
# (.env לא עולה ב-SFTP ולא ב-git - לעדכן ידנית בשרת)

# פורט ייעודי - לא בשימוש באף מערכת אחרת ב-phptest1
PORT=3040
HOST=127.0.0.1

# הנתיב שבו האפליקציה מוגשת מאחורי nginx (planner.dolcemaster.co.il/finitionline)
BASE_PATH=/finitionline

# כתובת ציבורית מלאה (לקישורים במיילים)
APP_URL=https://planner.dolcemaster.co.il/finitionline/

# המנהל היחיד - קוד ההתחברות (OTP) נשלח רק לכתובת הזו
FINITIONLINE_ADMIN_EMAIL=gal@finitione.com

# תוקף סשן בימים
SESSION_DAYS=30

# 1 = להדפיס את קוד ה-OTP ללוג (לפיתוח מקומי בלבד)
OTP_DEBUG=0

# 1 = לא לשלוח שום מייל (בדיקות מקומיות). חובה בכל הרצת בדיקה - המכונה המקומית מגיעה ל-dc1
TEST_MODE=0
